{
  "data_integrity": {
    "cmd": ["imm", "audit", "--watchlist", "watchlist.json", "--history-root", "history", "--audit-root", "audit"]
  },
  "pit_integrity": {
    "steps": [
      ["padj", "rebuild", "--bars", "bars.json", "--actions", "actions.json", "--as-of", "2026-08-11", "--code", "600000", "--out", "rebuilt.json"],
      ["padj", "drift-check", "--bars", "rebuilt.json", "--actions", "actions.json", "--as-of", "2026-08-11", "--live", "live.json"]
    ]
  },
  "temporal_integrity": {
    "cmd": ["lf", "check", "--pipeline", "pipeline.json", "--json"]
  },
  "evidence_integrity": {
    "cmd": ["fl", "verify", "--state-dir", "ledger"]
  },
  "statistical_quality": {
    "cmd": ["qc", "check", "--returns", "returns.json", "--n-trials", "200", "--json"],
    "warn_verdict_prefix": "FAIL - n_trials"
  }
}
